#!/usr/bin/env bash
# Prepares an Amp orb to build and test this repository. Runs once per fresh orb and
# again on a stale snapshot, so every step must be idempotent and non-interactive.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local name="$1"
  shift
  echo "==> $name"
  local start=$SECONDS
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

check_node() {
  # package.json requires Node >= 20; the orb base image ships a newer Node.
  node -e 'const major = Number(process.versions.node.split(".")[0]); if (major < 20) { console.error(`Node ${process.version} is older than the required 20`); process.exit(1); }'
  echo "node $(node -v), npm $(npm -v)"
}

unshallow() {
  # build-plan and finish-plan merge the pull request's base, which fails in a shallow clone.
  # They also unshallow before that merge, so a failure here only warns: in a new orb the
  # GitHub credentials can arrive after setup starts.
  if [[ "$(git rev-parse --is-shallow-repository)" != "true" ]]; then
    echo "already a full clone"
    return
  fi
  local -a fetch=(git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 fetch --quiet --unshallow origin)
  if command -v timeout >/dev/null 2>&1; then
    fetch=(timeout 120 "${fetch[@]}")
  fi
  if ! GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never "${fetch[@]}"; then
    echo "warning: could not unshallow the clone (GitHub credentials may not be ready yet)." >&2
    echo "warning: build-plan and finish-plan unshallow before they merge the base; to do it now, run: git fetch --unshallow origin" >&2
  fi
}

select_env() {
  # An Amp orb is the Amp harness on the orb workspace. Repository scope: the orb's own
  # clone is nobody else's, and the build below, every later hook-run build and
  # `metafab env` in the orb read it. `git config` replaces the value, so rerunning is a no-op.
  git config factory.env.harness amp
  git config factory.env.workspace orb
  echo "harness $(git config factory.env.harness), workspace $(git config factory.env.workspace)"
}

step "Check Node" check_node
# npm ci keeps package-lock.json untouched; npm install can rewrite it.
step "Install dependencies" npm ci --no-audit --no-fund
step "Build dist/" npm run build --silent
# The factory skills in .agents/skills/ (which Amp reads) are generated, not committed.
# The selection must be in Git config before the build, and before any later hook-run build.
step "Select the Amp environment" select_env
step "Install factory skills" node dist/cli.js build
step "Unshallow the clone" unshallow

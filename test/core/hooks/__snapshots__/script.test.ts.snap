// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`hookScript > snapshot per hook > post-checkout 1`] = `
"#!/bin/sh
# metafab:start
# Generated by metafab build 1.2.3. Set git-hooks: false in .factory/metafab.yaml to remove.
[ "$3" = "1" ] || exit 0
cd "$(git rev-parse --show-toplevel)/." 2>/dev/null || exit 0
[ -d .factory ] || exit 0
if [ -x node_modules/.bin/metafab ]; then node_modules/.bin/metafab build
elif command -v metafab >/dev/null 2>&1; then metafab build
else npx --yes @seasb/metafab@1.2.3 build
fi || echo "metafab: build failed. Run metafab build." >&2
exit 0
# metafab:end
"
`;


{
  "name": "@seasb/metafab",
  "version": "1.0.0",
  "description": "Create, validate, install, and share software factories.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Traction-Team/meta-harness.git"
  },
  "type": "module",
  "bin": {
    "metafab": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "resources",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755);\"",
    "verify": "npm run typecheck && npm run test && npm run factory",
    "factory": "npm run build && node dist/cli.js build && git diff --exit-code -- AGENTS.md CLAUDE.md .gitignore .gitattributes && node dist/cli.js check && node .factory/scripts/check.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.8.0",
    "@types/ssri": "^7.1.5",
    "@types/validate-npm-package-name": "^4.0.2",
    "typescript": "^7.0.2",
    "verdaccio": "6.8.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "node-diff3": "^3.2.1",
    "picomatch": "^4.0.7",
    "semver": "^7.8.5",
    "ssri": "^14.0.0",
    "tar": "^7.5.22",
    "validate-npm-package-name": "^5.0.1",
    "yaml": "^2.9.1"
  }
}

{
  "name": "@seasb/metafab",
  "version": "0.1.0",
  "description": "Create, validate, install, and share software factories.",
  "type": "module",
  "bin": {
    "metafab": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "resources",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755);\"",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
